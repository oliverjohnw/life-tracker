# Copy this file to .env for local development. Railway sets the production
# equivalents of these as project variables in its dashboard instead.

SECRET_KEY=change-me-to-a-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=America/Chicago

# Leave unset locally to use SQLite. Railway sets this automatically when you
# attach a Postgres plugin.
# DATABASE_URL=postgres://user:password@host:port/dbname

# Google Sheets import — one of the two credential options below, plus the
# sheet ID from its URL (docs.google.com/spreadsheets/d/<THIS_PART>/edit).
# GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}
# GOOGLE_APPLICATION_CREDENTIALS=./google-service-account.json
CONCERTS_SHEET_ID=

# Other sheets to import from
MOVIES_SHEET_ID=
SPORTS_SHEET_ID=

# Where uploaded images live. Locally the default (./media) is fine; on Railway
# point this at a mounted volume, e.g. /data/media
# MEDIA_ROOT=/data/media
